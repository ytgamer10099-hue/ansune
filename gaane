                cover: "https://images.unsplash.com/photo-1516450360452-9312f5e86fc7?w=500&auto=format&fit=crop&q=80",
                src: "https://cdn.pixabay.com/download/audio/2022/01/18/audio_d0a13f69d2.mp3?filename=sweet-romantic-string-9852.mp3"
            },
            {
                id: 7,
                title: "Tere Vaaste",
                artist: "Varun Jain, Sachin-Jigar",
                album: "Zara Hatke Zara Bachke",
                year: "2023",
                category: "naye",
                genre: "Romantic",
                duration: "3:09",
                cover: "https://images.unsplash.com/photo-1470225620780-dba8ba36b745?w=500&auto=format&fit=crop&q=80",
                src: "https://cdn.pixabay.com/download/audio/2022/05/16/audio_db6f3876e5.mp3?filename=happy-acoustic-guitar-111019.mp3"
            },
            {
                id: 8,
                title: "Chura Liya Hai Tumne",
                artist: "Asha Bhosle, Mohd. Rafi",
                album: "Yaadon Ki Baaraat",
                year: "1973",
                category: "purane",
                genre: "Retro 80s-90s",
                duration: "4:45",
                cover: "https://images.unsplash.com/photo-1487180144351-b8472da7d491?w=500&auto=format&fit=crop&q=80",
                src: "https://cdn.pixabay.com/download/audio/2022/03/10/audio_51a24d2757.mp3?filename=smooth-acoustic-jazz-10512.mp3"
            },
            {
                id: 9,
                title: "Pehla Nasha",
                artist: "Udit Narayan",
                album: "Jo Jeeta Wohi Sikandar",
                year: "1992",
                category: "purane",
                genre: "Retro 80s-90s",
                duration: "4:50",
                cover: "https://images.unsplash.com/photo-1520523839897-bd0b52f945a0?w=500&auto=format&fit=crop&q=80",
                src: "https://cdn.pixabay.com/download/audio/2021/11/24/audio_3d68019a28.mp3?filename=dreamy-piano-9653.mp3"
            },
            {
                id: 10,
                title: "Apna Bana Le",
                artist: "Arijit Singh",
                album: "Bhediya",
                year: "2022",
                category: "naye",
                genre: "Romantic",
                duration: "4:21",
                cover: "https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?w=500&auto=format&fit=crop&q=80",
                src: "https://cdn.pixabay.com/download/audio/2022/10/14/audio_9934149022.mp3?filename=heartfelt-acoustic-124312.mp3"
            }
        ];

        /* State Variables */
        let currentTrackIndex = 0;
        let isPlaying = false;
        let isShuffle = false;
        let isRepeat = false;
        let favorites = new Set(JSON.parse(localStorage.getItem('sangeet_favs')) || [2, 6]);
        let activeTab = 'all'; 
        let filteredSongs = [...songs];

        /* DOM Elements */
        let audio, songGrid, emptyState, playPauseBtn, playerCover, playerTitle, playerArtist;
        let playerBadge, playerDiscSpin, progressBar, currentTimeEl, totalDurationEl;
        let volumeSlider, favBadge, favCount, totalTracks, sectionTitle, sectionSub, resultCount, playerLikeBtn;

        function initDOMElements() {
            audio = document.getElementById('audioElement');
            songGrid = document.getElementById('songGrid');
            emptyState = document.getElementById('emptyState');
            playPauseBtn = document.getElementById('playPauseBtn');
            playerCover = document.getElementById('playerCover');
            playerTitle = document.getElementById('playerTitle');
            playerArtist = document.getElementById('playerArtist');
            playerBadge = document.getElementById('playerBadge');
            playerDiscSpin = document.getElementById('playerDiscSpin');
            progressBar = document.getElementById('progressBar');
            currentTimeEl = document.getElementById('currentTime');
            totalDurationEl = document.getElementById('totalDuration');
            volumeSlider = document.getElementById('volumeSlider');
            favBadge = document.getElementById('favBadge');
            favCount = document.getElementById('favCount');
            totalTracks = document.getElementById('totalTracks');
            sectionTitle = document.getElementById('sectionTitle');
            sectionSub = document.getElementById('sectionSub');
            resultCount = document.getElementById('resultCount');
            playerLikeBtn = document.getElementById('playerLikeBtn');
        }

        window.onload = () => {
            initDOMElements();
            updateBadgeCounts();
            renderSongs(songs);
            loadTrack(0, false);
            setupAudioEventListeners();
        };

        function updateBadgeCounts() {
            if (favBadge) favBadge.innerText = favorites.size;
            if (favCount) favCount.innerText = favorites.size;
            if (totalTracks) totalTracks.innerText = songs.length;
            localStorage.setItem('sangeet_favs', JSON.stringify(Array.from(favorites)));
        }

        function renderSongs(songsToRender) {
            songGrid.innerHTML = '';
            
            if (songsToRender.length === 0) {
                emptyState.classList.remove('hidden');
                emptyState.classList.add('flex');
            } else {
                emptyState.classList.add('hidden');
                emptyState.classList.remove('flex');
            }

            resultCount.innerText = `Showing ${songsToRender.length} track(s)`;

            songsToRender.forEach((song) => {
                const isFav = favorites.has(song.id);
                const isCurrentlyPlaying = songs[currentTrackIndex].id === song.id && isPlaying;

                const card = document.createElement('div');
                card.className = `song-card group bg-zinc-900/80 p-3.5 rounded-2xl border ${isCurrentlyPlaying ? 'border-emerald-500/80 bg-zinc-800/90' : 'border-zinc-800/80 hover:border-zinc-700'} flex flex-col justify-between cursor-pointer relative`;
                
                card.innerHTML = `
                    <div class="relative w-full aspect-square rounded-xl overflow-hidden mb-3 bg-zinc-800 shadow-lg">
                        <img src="${song.cover}" alt="${song.title}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105">
                        <span class="absolute top-2 left-2 text-[10px] font-bold px-2 py-0.5 rounded-full ${song.category === 'naye' ? 'bg-amber-500/90 text-black' : 'bg-rose-500/90 text-white'} backdrop-blur-md">
                            ${song.category === 'naye' ? 'NEW 🔥' : 'RETRO 📻'}
                        </span>
                        <button onclick="event.stopPropagation(); toggleFavorite(${song.id})" class="absolute top-2 right-2 w-7 h-7 rounded-full bg-black/50 backdrop-blur-md flex items-center justify-center text-xs ${isFav ? 'text-emerald-400' : 'text-zinc-400'} hover:scale-110 transition-transform">
                            <i class="${isFav ? 'fas' : 'far'} fa-heart"></i>
                        </button>
                        <div class="play-btn-overlay absolute inset-0 bg-black/40 flex items-center justify-center">
                            <button onclick="playSongById(${song.id})" class="w-12 h-12 rounded-full bg-emerald-500 text-black flex items-center justify-center text-lg shadow-xl shadow-emerald-500/40 transform hover:scale-110 transition-transform">
                                <i class="fas ${isCurrentlyPlaying ? 'fa-pause' : 'fa-play'} ml-0.5"></i>
                            </button>
                        </div>
                    </div>
                    <div class="space-y-1">
                        <h4 class="text-sm font-bold text-white truncate group-hover:text-emerald-400 transition-colors">${song.title}</h4>
                        <p class="text-xs text-zinc-400 truncate">${song.artist}</p>
                        <div class="flex items-center justify-between text-[11px] text-zinc-400 pt-1">
                            <span>${song.year}</span>
                            <span><i class="far fa-clock mr-1"></i>${song.duration}</span>
                        </div>
                    </div>
                `;

                card.onclick = () => playSongById(song.id);
                songGrid.appendChild(card);
            });
        }

        function loadTrack(index, shouldPlay = true) {
            currentTrackIndex = index;
            const track = songs[currentTrackIndex];

            audio.src = track.src;
            playerCover.src = track.cover;
            playerTitle.innerText = track.title;
            playerArtist.innerText = track.artist;
            playerBadge.innerText = track.category === 'naye' ? 'LATEST' : 'RETRO CLASSIC';
            playerBadge.className = `inline-block text-[9px] px-1.5 py-0.5 rounded mt-1 font-semibold uppercase ${track.category === 'naye' ? 'bg-amber-500/20 text-amber-400' : 'bg-rose-500/20 text-rose-400'}`;

            updatePlayerLikeBtn();

            if (shouldPlay) {
                audio.play().then(() => {
                    isPlaying = true;
                    updatePlayPauseUI();
                    showToast(`Sun rahe hain: ${track.title}`);
                }).catch(err => console.log("Playback start:", err));
            } else {
                isPlaying = false;
                updatePlayPauseUI();
            }

            renderSongs(filteredSongs);
        }

        function togglePlay() {
            if (!audio.src) return;

            if (isPlaying) {
                audio.pause();
                isPlaying = false;
            } else {
                audio.play();
                isPlaying = true;
            }
            updatePlayPauseUI();
            renderSongs(filteredSongs);
        }

        function updatePlayPauseUI() {
            if (isPlaying) {
                playPauseBtn.innerHTML = '<i class="fas fa-pause"></i>';
                playerDiscSpin.classList.remove('opacity-0');
            } else {
                playPauseBtn.innerHTML = '<i class="fas fa-play ml-0.5"></i>';
                playerDiscSpin.classList.add('opacity-0');
            }
        }

        function playSongById(id) {
            const index = songs.findIndex(s => s.id === id);
            if (index !== -1) {
                loadTrack(index, true);
            }
        }

        function nextSong() {
            if (isShuffle) {
                currentTrackIndex = Math.floor(Math.random() * songs.length);
            } else {
                currentTrackIndex = (currentTrackIndex + 1) % songs.length;
            }
            loadTrack(currentTrackIndex, true);
        }

        function prevSong() {
            currentTrackIndex = (currentTrackIndex - 1 + songs.length) % songs.length;
            loadTrack(currentTrackIndex, true);
        }

        function toggleShuffle() {
            isShuffle = !isShuffle;
            const btn = document.getElementById('shuffleBtn');
            btn.classList.toggle('text-emerald-400', isShuffle);
            btn.classList.toggle('text-zinc-400', !isShuffle);
            showToast(isShuffle ? "Shuffle On" : "Shuffle Off");
        }

        function toggleRepeat() {
            isRepeat = !isRepeat;
            const btn = document.getElementById('repeatBtn');
            btn.classList.toggle('text-emerald-400', isRepeat);
            btn.classList.toggle('text-zinc-400', !isRepeat);
            showToast(isRepeat ? "Repeat On" : "Repeat Off");
        }

        function playAll() {
            if (filteredSongs.length > 0) {
                playSongById(filteredSongs[0].id);
            }
        }

        function shufflePlay() {
            isShuffle = true;
            document.getElementById('shuffleBtn').classList.add('text-emerald-400');
            nextSong();
        }

        function toggleFavorite(id) {
            if (favorites.has(id)) {
                favorites.delete(id);
                showToast("Favorites se hataya gaya");
            } else {
                favorites.add(id);
                showToast("Favorites me joda gaya ❤️");
            }
            updateBadgeCounts();
            updatePlayerLikeBtn();

            if (activeTab === 'favorites') {
                filterFavorites();
            } else {
                renderSongs(filteredSongs);
            }
        }

        function toggleCurrentFavorite() {
            const currentSong = songs[currentTrackIndex];
            if (currentSong) {
                toggleFavorite(currentSong.id);
            }
        }

        function updatePlayerLikeBtn() {
            const currentSong = songs[currentTrackIndex];
            if (!currentSong || !playerLikeBtn) return;
            const isFav = favorites.has(currentSong.id);
            playerLikeBtn.innerHTML = `<i class="${isFav ? 'fas text-emerald-400' : 'far text-zinc-400'} fa-heart"></i>`;
        }

        function switchTab(tab) {
            activeTab = tab;
            document.getElementById('searchInput').value = '';
            document.getElementById('clearSearchBtn').classList.add('hidden');

            document.querySelectorAll('.nav-item').forEach(el => {
                el.classList.remove('text-emerald-400', 'bg-zinc-800/80');
                el.classList.add('text-zinc-400');
            });

            const activeNav = document.getElementById(`nav-${tab}`);
            if (activeNav) {
                activeNav.classList.add('text-emerald-400', 'bg-zinc-800/80');
                activeNav.classList.remove('text-zinc-400');
            }

            if (tab === 'all') {
                sectionTitle.innerText = "Sabhi Gaane";
                sectionSub.innerText = "Naye trends aur purane retro classics ek sath";
                filteredSongs = [...songs];
            } else if (tab === 'naye') {
                sectionTitle.innerText = "Naye Gaane (Latest Hits) 🔥";
                sectionSub.innerText = "Aaj ke sabse popular chartbuster gaane";
                filteredSongs = songs.filter(s => s.category === 'naye');
            } else if (tab === 'purane') {
                sectionTitle.innerText = "Purane Gaane (Golden Retro) 📻";
                sectionSub.innerText = "80s aur 90s ke evergreen romantic aur classic hits";
                filteredSongs = songs.filter(s => s.category === 'purane');
            } else if (tab === 'favorites') {
                sectionTitle.innerText = "Aapke Favorite Songs ❤️";
                sectionSub.innerText = "Aapke pasand kiye hue gaano ki list";
                filteredSongs = songs.filter(s => favorites.has(s.id));
            }

            renderSongs(filteredSongs);
        }

        function filterCategory(genre) {
            sectionTitle.innerText = `${genre} Collection`;
            sectionSub.innerText = `Khaas ${genre} category ke gaane`;
            filteredSongs = songs.filter(s => s.genre === genre || s.album.includes(genre));
            renderSongs(filteredSongs);
        }

        function filterFavorites() {
            filteredSongs = songs.filter(s => favorites.has(s.id));
            renderSongs(filteredSongs);
        }

        function handleSearch() {
            const query = document.getElementById('searchInput').value.toLowerCase().trim();
            const clearBtn = document.getElementById('clearSearchBtn');

            if (query.length > 0) {
                clearBtn.classList.remove('hidden');
                sectionTitle.innerText = `Khoj: "${query}"`;
                sectionSub.innerText = `Search results`;

                filteredSongs = songs.filter(s => 
                    s.title.toLowerCase().includes(query) ||
                    s.artist.toLowerCase().includes(query) ||
                    s.album.toLowerCase().includes(query) ||
                    s.year.includes(query)
                );
            } else {
                clearBtn.classList.add('hidden');
                switchTab(activeTab);
            }
            renderSongs(filteredSongs);
        }

        function clearSearch() {
            document.getElementById('searchInput').value = '';
            document.getElementById('clearSearchBtn').classList.add('hidden');
            switchTab(activeTab);
        }

        function resetFilters() {
            clearSearch();
            switchTab('all');
        }

        function setupAudioEventListeners() {
            audio.ontimeupdate = () => {
                if (!isNaN(audio.duration)) {
                    const pct = (audio.currentTime / audio.duration) * 100;
                    progressBar.value = pct;
                    currentTimeEl.innerText = formatTime(audio.currentTime);
                    totalDurationEl.innerText = formatTime(audio.duration);
                }
            };

            audio.onended = () => {
                if (isRepeat) {
                    audio.currentTime = 0;
                    audio.play();
                } else {
                    nextSong();
                }
            };
        }

        function seekAudio(value) {
            if (!isNaN(audio.duration)) {
                audio.currentTime = (value / 100) * audio.duration;
            }
        }

        function setVolume(value) {
            audio.volume = value / 100;
            const icon = document.getElementById('volumeIcon');
            if (audio.volume === 0) {
                icon.innerHTML = '<i class="fas fa-volume-mute text-rose-400"></i>';
            } else if (audio.volume < 0.5) {
                icon.innerHTML = '<i class="fas fa-volume-down"></i>';
            } else {
                icon.innerHTML = '<i class="fas fa-volume-up"></i>';
            }
        }

        function toggleMute() {
            if (audio.volume > 0) {
                audio.volume = 0;
                volumeSlider.value = 0;
                document.getElementById('volumeIcon').innerHTML = '<i class="fas fa-volume-mute text-rose-400"></i>';
            } else {
                audio.volume = 0.8;
                volumeSlider.value = 80;
                document.getElementById('volumeIcon').innerHTML = '<i class="fas fa-volume-up"></i>';
            }
        }

        function formatTime(seconds) {
            const min = Math.floor(seconds / 60);
            const sec = Math.floor(seconds % 60);
            return `${min}:${sec < 10 ? '0' : ''}${sec}`;
        }

        let toastTimeout;
        function showToast(msg) {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-msg');
            toastMsg.innerText = msg;

            toast.classList.remove('translate-y-[-100px]', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            clearTimeout(toastTimeout);
            toastTimeout = setTimeout(() => {
                toast.classList.add('translate-y-[-100px]', 'opacity-0');
                toast.classList.remove('translate-y-0', 'opacity-100');
            }, 2600);
        }

        function toggleMobileSidebar() {
            const sidebar = document.getElementById('mobileSidebar');
            sidebar.classList.toggle('hidden');
        }
    </script>
</body>
</html>
